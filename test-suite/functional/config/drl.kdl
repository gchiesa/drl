// DRL - Functional Test Configuration
// Low limits to validate rate limiting within a 1-minute test window

listen {
    grpc ":8081"
    metrics ":9091"
}

membership {
    service-name "drl"
    port 7946
    bind-addr "0.0.0.0"
    startup-delay "3s"
}

logging {
    level "info"
    format "text"
}

internal-api {
    enabled true
    address ":8082"
}

accounting {
    settings {
        algorithm "sliding-window"
        retry-after-type "delay-seconds"
        flush-interval "200ms"
        max-batch-size 5
    }
    rules {
        "test-endpoint" {
            path-prefix "/anything"
            limit 30
            per "minute"
        }
    }
}
