// DRL - Handover Test Configuration
// Tests accounting state transfer when a DRL instance shuts down gracefully.
//
// Rate limit: 30 req/min per entity.
// Entity discrimination: the "x-test-entity" header creates 20 distinct
// entities distributed across 2 DRL instances via consistent hashing.
// Envoy normalises header names to lowercase in HTTP/2 ext_authz requests.

listen {
    grpc ":8081"
    metrics ":9091"
}

membership {
    service-name "drl"
    port 7946
    bind-addr "0.0.0.0"
    startup-delay "3s"
}

logging {
    level "info"
    format "text"
}

internal-api {
    enabled true
    address ":8082"
}

accounting {
    settings {
        algorithm "sliding-window"
        retry-after-type "delay-seconds"
        flush-interval "200ms"
        max-batch-size 5
    }
    rules {
        "test-endpoint" {
            path-prefix "/anything"
            limit 30
            per "minute"
            headers "x-test-entity"
        }
    }
}
