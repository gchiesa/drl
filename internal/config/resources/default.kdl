// DRL - Distributed Rate Limiter Configuration
// Default configuration

listen {
    grpc ":8081"
    metrics ":9091"
}

membership {
    service-name "drl"
    port 7946
    bind-addr "0.0.0.0"
    startup-delay "3s"
    gossip-interval "50ms"
    gossip-nodes 5
}

logging {
    level "info"
    format "json"
}

internal-api {
    enabled true
    address ":8082"
}

cache {
    blocklist-size-mb 64
    accounting-size-mb 128
    sync-timeout-seconds 30
    blocklist-default-ttl-seconds 300
}

accounting {
    settings {
        algorithm "sliding-window"
        retry-after-type "delay-seconds"
        flush-interval "10s"
        max-batch-size 1000
    }
}