// DRL - Distributed Rate Limiter Configuration
// Default configuration

listen {
    grpc ":8081"
    metrics ":9091"
}

membership {
    service-name "drl"
    port 7946
    bind-addr "0.0.0.0"
    startup-delay "3s"
}

logging {
    level "info"
    format "json"
}

internal-api {
    enabled true
    address ":8082"
}

cache {
    blocklist-size-mb 64
    accounting-size-mb 128
    sync-timeout-seconds 30
    blocklist-default-ttl-seconds 300
}