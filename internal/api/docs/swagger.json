{
    "swagger": "2.0",
    "info": {
        "description": "DRL Distributed Rate Limiter — Private Management API (port 8082).\nProvides cluster status, blocklist management, accounting statistics, and configuration access.",
        "title": "DRL Private API",
        "contact": {
            "name": "DRL Project",
            "url": "https://github.com/gchiesa/drl"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/v1",
    "paths": {
        "/accounting/load": {
            "post": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Ingests a stream of NDJSON records into the accounting cache without rate-limit evaluation.\nUseful for warming cache state or load-testing. Does not trigger blocking.",
                "consumes": [
                    "application/x-ndjson"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "accounting"
                ],
                "summary": "Bulk-load accounting entries",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Forward records owned by remote nodes via the flusher (default: false)",
                        "name": "distributionEnabled",
                        "in": "query"
                    },
                    {
                        "description": "NDJSON stream — one record per line",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.BulkLoadLine"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.BulkLoadResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.BulkLoadResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/accounting/stats": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Returns local accounting statistics for this node: tracked entities, pending updates, and cache estimates.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "accounting"
                ],
                "summary": "Get accounting statistics",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.AccountingStatsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/blocked-entity": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Returns all entities currently held in the local blocklist cache.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "blocklist"
                ],
                "summary": "List blocked entities",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.BlockedEntityEntry"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/blocked-entity/{ip}/_path/{path}": {
            "post": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Adds the entity (IP + URI path + optional headers) to the local blocklist and gossips a BlockEvent to all cluster peers.\nAppend `/_headers/key:val,key2:val2` to the path to scope the block to specific request headers.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "blocklist"
                ],
                "summary": "Block an entity",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Source IP address",
                        "name": "ip",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "URI path; append /_headers/key:val to include headers",
                        "name": "path",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Block TTL in seconds (default: configured blocklist-default-ttl-seconds)",
                        "name": "ttl",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.EntityResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.EntityResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Removes the matching entity from the local blocklist and gossips an UnblockEvent to all cluster peers.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "blocklist"
                ],
                "summary": "Unblock an entity",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Source IP address",
                        "name": "ip",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "URI path; append /_headers/key:val to match headers",
                        "name": "path",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.EntityResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.EntityResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/configuration/static/{section}": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Returns the JSON representation of a named top-level configuration section.\nSensitive fields (encryption keys, passwords) are redacted via json:\\\"-\\\" tags.\nValid sections: accounting, membership, cache, listen, logging, internal-api",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "configuration"
                ],
                "summary": "Get static configuration section",
                "parameters": [
                    {
                        "enum": [
                            "accounting",
                            "membership",
                            "cache",
                            "listen",
                            "logging",
                            "internal-api"
                        ],
                        "type": "string",
                        "description": "Configuration section name",
                        "name": "section",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Returns cluster membership information and uptime for this node.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cluster"
                ],
                "summary": "Get cluster status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.StatusResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ui/api/metrics": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    },
                    {
                        "BearerToken": []
                    }
                ],
                "description": "Returns a flat JSON snapshot of the current Prometheus metric values for the dashboard UI.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ui"
                ],
                "summary": "Get node metrics snapshot",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.UIMetricsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ui/get-token": {
            "get": {
                "security": [
                    {
                        "DigestAuth": []
                    }
                ],
                "description": "Issues a short-lived (10-minute) bootstrap token required to initiate the ECDH key exchange.\nProtected by Digest authentication. Retrieve out-of-band and paste into the SPA token modal.\nExample: `curl --digest -u \"admin:$DRL_PRIVATE_API_KEY\" http://localhost:8082/v1/ui/get-token`",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ui"
                ],
                "summary": "Get bootstrap token",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GetTokenResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.AccountingStatsResponse": {
            "type": "object",
            "properties": {
                "batched_updates_pending": {
                    "type": "integer"
                },
                "estimated_entities_count": {
                    "type": "integer"
                },
                "local_node_id": {
                    "type": "string"
                },
                "monitored_entities_count": {
                    "type": "integer"
                }
            }
        },
        "models.BlockedEntityEntry": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "string"
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "uriPath": {
                    "type": "string"
                }
            }
        },
        "models.BulkLoadLine": {
            "type": "object",
            "required": [
                "path",
                "sourceIP"
            ],
            "properties": {
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "path": {
                    "type": "string"
                },
                "sourceIP": {
                    "type": "string"
                }
            }
        },
        "models.BulkLoadResponse": {
            "type": "object",
            "properties": {
                "accepted_local": {
                    "type": "integer"
                },
                "accepted_remote": {
                    "type": "integer"
                },
                "dropped": {
                    "type": "integer"
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                },
                "invalid": {
                    "type": "integer"
                },
                "no_match": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "models.EntityResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "uriPath": {
                    "type": "string"
                }
            }
        },
        "models.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "details": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "models.GetTokenResponse": {
            "type": "object",
            "properties": {
                "bootstrap_token": {
                    "type": "string"
                }
            }
        },
        "models.StatusResponse": {
            "type": "object",
            "properties": {
                "active_peer_addresses": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "active_peers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "cluster_name": {
                    "type": "string"
                },
                "node_id": {
                    "type": "string"
                },
                "uptime": {
                    "type": "string"
                },
                "uptime_seconds": {
                    "type": "number"
                }
            }
        },
        "models.UIMetricsResponse": {
            "type": "object",
            "properties": {
                "metrics": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number"
                    }
                },
                "nodeId": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerToken": {
            "description": "ECDH session token. Format: `DRL-Session \u003ctoken\u003e` or `Bearer \u003ctoken\u003e`. Obtain via POST /v1/ui/exchange after completing key exchange.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "DigestAuth": {
            "description": "HTTP Digest Authentication (RFC 7616, SHA-256). Use curl: `curl --digest -u \"admin:$DRL_PRIVATE_API_KEY\" http://localhost:8082/v1/status`",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}