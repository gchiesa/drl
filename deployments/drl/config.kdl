// DRL - Distributed Rate Limiter Configuration
// Docker deployment configuration

listen {
    grpc ":8081"
    metrics ":9091"
}

membership {
    service-name "drl"
    port 7946
    bind-addr "0.0.0.0"
    startup-delay "3s"
}

logging {
    level "debug"
    format "json"
}

internal-api {
    enabled true
    address ":8082"
}

accounting {
    rules {
        anything path-prefix="/anything" limit=100 per="minute"
        status path-prefix="/status" limit=20 per="second"
    }
}